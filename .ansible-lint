################################################################################
# Root ansible-lint configuration
#
# This file applies GLOBALLY to every project in this repository.
# It is the LAST RESORT override — only put rules here that must apply
# everywhere with no exceptions.
#
# Per-project overrides
# ---------------------
# Each top-level project directory (zos_concepts/, zos_subsystems/, etc.)
# may contain its own .ansible-lint file for project-specific exclusions
# or rule tuning. ansible-lint walks UP from the directory it is invoked
# on, so a project-level .ansible-lint is found first and takes precedence
# over this file for anything it defines.
#
# When to add something HERE vs a project .ansible-lint
# ------------------------------------------------------
#   Root (this file) : non-project dirs to skip (meta, docs, etc.),
#                      verbosity, and rules that must apply repo-wide
#   Project file     : exclude_paths for test fixtures, generated files,
#                      or playbooks that cannot be linted in CI (e.g.
#                      files that reference vaults or missing includes)
#
# Reverting per-project configs
# -----------------------------
# To revert to a single root config, delete the project-level .ansible-lint
# files and move their exclude_paths back into this file using full paths
# relative to the repo root (e.g. zos_concepts/certificate_management/...).
################################################################################

verbosity: 0

# Directories that are not Ansible projects — skip them entirely.
# ansible-lint will still be invoked on them by the CI loop but will
# find nothing to lint and exit cleanly (Passed: 0 files).
exclude_paths:
  - meta
  - collections
  - docs
  - .github
  - roles
  - scripts
  - "**/host_vars"

# Global skip list — rules disabled for the entire repository.
# To disable a rule for a single project only, add it to that
# project's .ansible-lint skip_list instead.
# skip_list:
