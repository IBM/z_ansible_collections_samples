exclude_paths:
  - data_transfer/copy_sort_fetch/roles/*/tests/test.yml
  - data_transfer/dump_pack_ftp_unpack_restore/roles/*/tests/test.yml
  - program_authorization/git_apf/roles/*/tests/test.yml
  - user_management/add_remove_user/roles/*/tests/test.yml

skip_list:
  - args[module]
  - command-instead-of-module
  - command-instead-of-shell
  - deprecated-command-syntax
  - deprecated-local-action
  - ignore-errors
  - jinja[spacing]
  - meta-incorrect
  - meta-no-info
  - meta-no-tags
  - name[missing]
  - name[play]
  - name[template]
  - no-changed-when
  - no-handler
  - no-relative-paths
  - package-latest
  - risky-file-permissions
  - risky-shell-pipe
  - role-name
  - schema[vars]
  - var-naming
  - yaml[line-length]